<article class="post">
  <header class="post-header">
    <h1 class="post-title-main"><%= page.title %></h1>
    <p class="post-meta-line">
      <span>$ date</span>
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD HH:mm') %></time>
      <% if (page.tags && page.tags.length){ %>
        <span class="post-tags">
          <% page.tags.each(function(tag){ %><span class="tag">#<%= tag.name %></span><% }) %>
        </span>
      <% } %>
    </p>
  </header>
  <div class="post-body">
    <%- page.content %>
  </div>
  <footer class="post-footer">
    <a href="<%- url_for('/archives/') %>">← back to archives</a>
  </footer>
</article>
